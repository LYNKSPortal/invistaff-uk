# Resend API key used by the contact form (src/app/api/contact/route.ts) to
# send submissions to the inbox configured as siteConfig.contactFormRecipient
# in src/lib/site.ts. Get this from https://resend.com/api-keys
#
# Without this set, the contact form will log submissions to the server
# console instead of emailing them (useful for local development).
RESEND_API_KEY=
